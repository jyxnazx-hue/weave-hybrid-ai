# Firebase Configuration for Weave (#BuildHybridAI 2026)
VITE_FIREBASE_API_KEY=your_gemini_or_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=weave-hybrid-ai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=weave-hybrid-ai
VITE_FIREBASE_STORAGE_BUCKET=weave-hybrid-ai.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# Firebase App Check Configuration
VITE_FIREBASE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key_here
# Set to true for auto-generated debug token in development or provide a pre-shared UUID debug token
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=true
